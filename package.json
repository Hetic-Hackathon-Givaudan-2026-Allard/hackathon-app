{
  "name": "hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "tools/data-mock"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write . '!db/data'",
    "format:check": "prettier --check . '!db/data'",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "dev:mock": "npm run dev -w data-mock"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml,html,css}": "prettier --write",
    "*.{ts,js,mjs,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
